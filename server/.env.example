# Server Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Relational Database Configuration
# For local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=surat_weather_db
DB_SSL=false

# Alternatively, for Cloud Managed MySQL (Aiven, Render, PlanetScale):
# DATABASE_URL=mysql://username:password@host:port/surat_weather_db?ssl-mode=REQUIRED

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_EMAIL=admin@suratweather.edu
ADMIN_PASSWORD=AdminPassword@2026

# Meteorological API Integration
# Sign up at https://openweathermap.org/api to obtain a free key
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
